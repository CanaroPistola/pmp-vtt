# ============================================================
# Godot 4 — .gitignore
# ============================================================

# Cache e arquivos importados gerados pela engine (recriados ao abrir o projeto)
.godot/

# Configurações locais do editor (específicas de cada máquina)
.editor/
*.translation

# Mono / C# (só se um dia usar C#)
.mono/
data_*/
mono_crash.*.json

# Exports / builds
build/
builds/
export/
*.exe
*.pck
*.apk
*.aab
*.dmg
*.app
*.x86_64
*.arm64
*.wasm

# export_presets.cfg pode conter chaves, senhas e caminhos locais.
# Se quiser versionar os presets, remova esta linha e guarde os segredos
# em export_credentials.cfg (ignorado abaixo).
export_presets.cfg
export_credentials.cfg

# Arquivos de override locais
override.cfg

# IDEs e editores
.vscode/
.idea/
*.code-workspace
*.sublime-workspace

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.tmp

# Logs e backups
*.log
*.bak
*.backup

# Python (scripts auxiliares de análise/conversão de dados)
__pycache__/
*.pyc
.venv/
venv/