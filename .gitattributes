# ============================================================
# Godot 4 — .gitattributes
# ============================================================
# Normaliza fins de linha: tudo vira LF no repositório
* text=auto eol=lf
# --- Arquivos de texto do Godot (sempre LF) ---
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.gdextension text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.res binary
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.translation binary
# --- Dados e documentação ---
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
# --- Scripts de shell precisam de LF; .bat/.cmd do Windows usam CRLF ---
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# --- Binários (não mexer em fim de linha, não gerar diff de texto) ---
# Imagens
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.icns binary
*.svg text eol=lf
*.exr binary
*.hdr binary
*.psd binary
*.kra binary
*.aseprite binary
# Áudio
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
# Vídeo
*.mp4 binary
*.webm binary
*.ogv binary
# Fontes
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
# Modelos 3D
*.glb binary
*.gltf text eol=lf
*.fbx binary
*.obj text eol=lf
*.blend binary
# Pacotes e builds
*.pck binary
*.zip binary
*.rar binary
*.7z binary
# --- Git LFS (opcional) ---
# Se o projeto crescer com muitos assets pesados (sprites, áudio, modelos),
# descomente as linhas abaixo e rode `git lfs install` antes do primeiro commit.
# *.png filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text
# *.mp3 filter=lfs diff=lfs merge=lfs -text
# *.glb filter=lfs diff=lfs merge=lfs -text
# *.psd filter=lfs diff=lfs merge=lfs -text
# --- Exclui do tarball gerado por `git archive` ---
.gitattributes export-ignore
.gitignore export-ignore
assets/ filter=lfs diff=lfs merge=lfs -text
