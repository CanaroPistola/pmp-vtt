display_name = "Icy Wind (Vento Gelado)"
name_en = "Icy Wind"
name_pt = "Vento Gelado"
type = 5
move_time = "1 ação"
resolution = 2
has_save = true
range_category = 3
range_distance = 12.0
description = "Você cria um vento gélido que sopra à sua frente em um cone de 12 metros. Qualquer criatura pega no cone deve ter sucesso em um teste de DES contra sua CD de Move -1, sofrendo 1d12 + MOVE de dano de gelo em uma falha, ou metade do dano em um sucesso. Além disso, aqueles que falharem também terão suas Velocidades reduzidas em 1 estágio, podendo ser acumulado em até -6 estágios. Uma criatura cuja Velocidade seja reduzida a 0 com este Move fica impedida. O alvo pode gastar uma ação para tentar se livrar de qualquer gelo com um teste de FOR contra sua CD de Move."
scaling_text = "O dado de dano para este Move muda para 4d4 no nível 5, 2d12 no nível 10 e 3d10 no nível 17."
range_text_raw = "Pessoal (cone de 12 metros)"
duration_text_raw = "Instantânea"
