script = ExtResource("1_8mje2")
id = "frustration"
display_name = "Frustration (Frustração)"
name_en = "Frustration"
name_pt = "Frustração"
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você ataca uma criatura, desabafando sua frustração com seu treinador. Faça um ataque corpo a corpo contra uma criatura, causando 2d6 + MOVE de dano normal em um acerto. Ao fazer este ataque, acrescente um dado de dano adicional igual ao número de níveis abaixo de zero na tabela de Lealdade, ou remova um dado de dano igual ao número de níveis acima (mínimo de 1 de dano). Este Move ignora a penalidade de rolagem de Lealdade, exceto para criaturas incontroláveis com base em limitações do SR."
scaling_text = "Os dados de dano para este Move mudam para 2d8 no nível 5, 2d10 no nível 10 e 3d8 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
