id = "body_slam"
display_name = "Body Slam (Golpe de Corpo)"
name_en = "Body Slam"
name_pt = "Golpe de Corpo"
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você se lança em direção a uma criatura na tentativa de esmagá-la com seu tamanho físico. Faça um ataque corpo a corpo em um alvo. Em um acerto, o alvo sofre 4d4 + MOVE de dano normal. Em um resultado natural de 15 ou mais no acerto, o alvo recebe o status Paralisado. Se o alvo tiver usado Minimize, Body Slam causa um acerto garantido e o dobro dos dados de dano, desde que você possa vê-lo e ele esteja dentro do seu alcance (mas role um d20 para chance de golpe crítico e outros efeitos)."
scaling_text = "Os dados de dano para este Move mudam para 4d6 no nível 5, 4d8 no nível 10 e 5d8 no nível 17."
