range_distance = 12.0
description = "Você dispara uma série de espinhos afiados em uma criatura no alcance. Faça um ataque à distância em uma criatura, causando 1d4 + MOVE de dano normal em um acerto. Em um acerto, após isso, role um d8 e compare o resultado com a tabela abaixo para determinar a quantidade de golpes. Para cada golpe adicional, você pode imediatamente realizar um novo ataque contra o mesmo alvo com acerto garantido, causando 1d4 + MOVE de dano normal. Cada golpe extra deve rolar separadamente 1d20 para verificar chance de crítico."
scaling_text = "O dado de dano para esse Move muda para 1d6 no nível 5, 1d8 no nível 10 e 1d10 no nível 17. Confira a tabela."
range_text_raw = "(12 metros)"
duration_text_raw = "Instantânea"
