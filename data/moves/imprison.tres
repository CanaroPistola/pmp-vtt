description = "Você emite ondas psíquicas que interferem na mente de seus inimigos, selando o acesso a técnicas que você conhece. Enquanto você permanecer em combate (isto é, até ser derr otado ou substituído), qualquer criatura inimiga a até 30 pés (9 metros) de você que tentar usar um Move que você também conheça deve fazer um teste de resistência de SAB contra sua CD de Move. Em caso de falha, ela não pode usar Moves que você conheça enquanto este efeito estiver ativo . Imprison não possui efeito com o Move Struggle. Observações: Este Move ignora Substitute."
range_text_raw = "(9 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([3, 4])
