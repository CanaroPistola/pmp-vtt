[resource]
script = ExtResource("1_5n835")
id = "roar"
display_name = "Roar"
name_en = "Roar"
move_time = "1 ação"
resolution = 2
has_save = true
save_attribute = 4
range_category = 2
range_distance = 6.0
description = "Você solta um rugido intimidador contra uma criatura a até 20 pés (6 metros) de você e que possa ouvi -lo. Role 1d20 + MOVE + 9 e co mpare o resultado com 10 + SAB do alvo. Em um resultado maior ou igual, o efeito depende do tipo de encontro. Em encontros selvagens: Se o alvo for de um nível igual ou menor que você, ele tenta fugir do combate imediatamente. Em batalhas contra treinadores: O alvo fica Amedrontado e, se possível, é imediatamente substituído por outro Pokémon da equipe, à escolha do treinador. Se não houver outro Pokémon disponível, ou se o alvo estiv er impossibilitado de ser trocado por Habilidade, item ou condição de combate, ele fica apenas Amedrontado e deve usar sua ação neste turno para se afastar de você o máximo possível, sem provocar ataques de oportunidade. Uma criatura Amedrontada dessa forma deve fazer um teste de SAB no final de cada um de seus turnos contra uma CD igual a 10 + o bônus de proficiência do usuário deste Move. Em caso de sucesso, ela deixa de estar Amedrontada. Este Move ignora reações de proteção, como Protect ou Detect. Observações: Roar é um Move baseado em som . Roar não pode ser escolhido pelo Move Assist."
range_text_raw = "(6 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([0, 5])
effect_tags = Array[String](["flinch"])
