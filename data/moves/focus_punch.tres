script = ExtResource("1_cgn3a")
id = "focus_punch"
display_name = "Focus Punch (Soco Focalizado)"
name_en = "Focus Punch"
name_pt = "Soco Focalizado"
type = 6
move_time = "1 ação"
is_attack = true
resolution = 1
duration_rounds = 1
duration_flags = Array[String](["concentration"])
description = "Ao ativar este Move, você entra em estado de foco, preparando um poderoso ataque. Você não realiza um ataque imediatamente. Em vez disso, você gasta sua ação atual focando. No início de seu próximo turno, se você mantiver a concentração, você executa o golpe com uma ação livre, realizando um ataque corpo a corpo contra uma criatura, causando 5d6 + MOVE de dano lutador em um acerto. Para este Move, você pode escolher usar sua movimentação em seu turno ou ao executar o ataque (sem gastar movimentação adicional no próximo turno)."
scaling_text = "Os dados de dano para este Move mudam para 5d8 no nível 5, 6d10 no nível 10 e 6d12 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "1 rodada, Concentração"
role = 0
