script = ExtResource("1_rad65")
id = "first_impression"
display_name = "First Impression (Primeira Impressão)"
name_en = "First Impression"
name_pt = "Primeira Impressão"
type = 11
pp = 5
move_time = "1 ação bônus"
is_attack = true
resolution = 1
activation = 2
description = "Você faz uma entrada impressionante, atacando rapidamente uma criatura. Este ataque só pode ser usado no primeiro turno em que o usuário age em combate. Como uma ação, você pode se mover imediatamente até 10 pés (3 metros) sem provocar ataques de oportunidade, e realizar um ataque corpo a corpo contra uma criatura ao alcance, causando 3d6 + MOVE de dano do tipo Inseto em um acerto. Este Move também pode ser usado como reação para ser executado a qualquer momento da rodada, desde que ocorra fora do turno de outra criatura e antes do início do seu turno. Se usar esta reação, você perde a ação padrão do seu próximo turno. Para poder usar First Impression novamente, o Pokémon precisa ser retirado e enviado de volta à batalha. Este Move é classificado como Prioridade 2. Caso outra criatura utilize um Move de Prioridade 2 no mesmo momento, a ordem de execução é determinada pela Destreza (ou por uma rolagem, em caso de empate). Moves com valores mais altos de Prioridade são sempre executados antes."
scaling_text = "Os dados de dano para este Move mudam para 3d10 no nível 5, 3d12 no nível 10 e 4d12 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
role = 0
