range_category = 3
range_distance = 12.0
description = "Você libera ventos brutalmente gelados que fazem corpo e espírito do alvo estremecerem em um cone de 40 pés (12 metros). Qualquer criatura pega no cone deve ter sucesso em um teste de DES contra sua CD de Move -2, sofrendo 2d10 + MOVE de dano voador em uma falha, ou metade do dano em um sucesso. Qualquer criatura que rolar um resultado natural de 6 ou menos no teste terá sua Velocidade reduzida em 1 estágio, podendo ser acumulado em até -6 estágios. Caso este Move seja usado durante a chuva, remova o -2 na CD, e os alvos rolam o teste na desvantagem."
scaling_text = "Os dados de dano para este Move mudam para 5d6 no nível 5, 5d8 no nível 10 e 5d10 no nível 17."
range_text_raw = "Pessoal (cone de 12 metros)"
duration_text_raw = "Instantânea"
