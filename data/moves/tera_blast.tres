range_distance = 15.0
range_secondary = 1.5
description = "Você libera uma explosão de energia cristalina, que assume o brilho e a força do seu Tipo Tera quando você está Teracristalizado. Faça um ataque à distância contra um alvo em alcance, causando 4d4 + MOVE de dano do tipo Normal, ou do Tipo Tera do usuário se ele estiver Teracristalizado. Se você estiver Teracristalizado, o tipo deste Move não pode ser alterado por Moves ou efeitos que mudam o tipo de um ataque, e este Move passa a poder ser usado também como corpo a corpo, sem acionar efeitos de inimigos que se ativam ao contato corpo a corpo. Se você estiver Teracristalizado no tipo Estelar, este Move é considerado super efetivo contra qualquer alvo que também esteja Teracristalizado, e causa dano neutro contra qualquer alvo que não esteja. Além disso, seu dano aumenta em mais um dado de dano, porém seu Ataque e o Ataque Especial são reduzidos em 1 estágio cada, podendo ser acumulados em até -6 estágios."
scaling_text = "Os dados de dano para este Move mudam para 4d6 no nível 5, 4d8 no nível 10 e 4d10 no nível 17."
range_text_raw = "(15 metros) Corpo a corpo situacional"
duration_text_raw = "Instantânea"
role = 0
