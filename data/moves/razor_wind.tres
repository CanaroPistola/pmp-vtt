range_distance = 12.0
duration_rounds = 1
duration_flags = Array[String](["concentration"])
description = "Quando você usa este Move, ventos fortes começam a circular ao seu redor. No seu próximo turno, se você mantiver sua concentração, você libera esses ventos como uma ação em um cone de 12 metros. Qualquer criatura pega no cone deve ter sucesso em um teste de DES contra sua CD de Move, sofrendo 4d4 + MOVE de dano normal em uma falha, ou metade do dano em um sucesso. Para cada 5 pontos que uma criatura falhar abaixo da CD, ela sofre 1 dado de dano extra."
scaling_text = "Os dados de dano para este Move mudam para 4d6 no nível 5, 4d8 no nível 10 e 4d10 no nível 17."
range_text_raw = "Pessoal (cone de 12 metros)"
duration_text_raw = "1 rodada, Concentração"
