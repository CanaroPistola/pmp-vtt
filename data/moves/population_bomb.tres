script = ExtResource("1_fdfi4")
id = "population_bomb"
display_name = "Population Bomb"
name_en = "Population Bomb"
pp = 5
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Seus companheiros se reúnem em grande número para realizar um ataque combinado. Faça um ataque corpo a corpo -1 em uma criatura, causando 1d4 + MOVE de dano do tipo Normal em um acerto. Em um acerto, após isso, role um d20 e compare o resultado com a tabela abaixo para determinar a quantidade de golpes. Para cada golpe adicional, você pode imediatamente realizar um novo ataque contra o mesmo alvo com acerto garantido, causando 1d4 de dano do tipo Normal. Cada golpe extra deve rolar separadamente um d20 para verificar chance de crítico, mas não para efeitos secundários de habilidades ou itens."
scaling_text = "Os dados de dano para este Move mudam para 1d6 no nível 5, 1d8 no nível 10 e 1d10 no nível 17. Cada golpe de Population Bomb é tratado como um ataque separado: Habilidades que ativam com o contato (como Static, Weak Armor, Iron Barbs, etc.) são ativadas para cada golpe individualmente. Se o primeiro golpe quebrar um Substitute, o segundo golpe causará dano direto ao Pokémon alvo. O Move Counter revida apenas o golpe final, enquanto Bide revida todo o dano acumulado."
range_text_raw = "Corpo a Corpo"
duration_text_raw = "Instantânea"
role = 0
