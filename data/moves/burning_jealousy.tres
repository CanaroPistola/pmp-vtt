move_time = "1 ação"
resolution = 2
has_save = true
range_category = 3
range_distance = 12.0
description = "Você libera uma onda de energia alimentada por pura inveja em um cone de 40 pés (12 metros). Qualquer criatura pega no cone deve ter sucesso em um teste de DES contra sua CD de Move, sofrendo 2d8 + MOVE de dano de fogo em uma falha, ou metade do dano em um sucesso. Caso alguma das criaturas atingidas tenha aumentado alguma Mudança de Status desde o final do seu último turno, ela se torna queimada. Observações: Se o alvo tiver vulnerabilidade a Burning Jealousy e estiver segurando uma Weakness Policy, determinar se o oponente será queimado acontece antes da Weakness Policy ser consumida. Se o usuário tiver a habilidade Sheer Force, o aumento de dano é aplicado independentemente de Burning Jealousy queimar ou não o alvo."
scaling_text = "Os dados de dano para este Move mudam para 1d20 no nível 5, 3d10 no nível 10 e 3d12 no nível 17."
range_text_raw = "Pessoal (cone de 12 metros)"
duration_text_raw = "Instantânea"
