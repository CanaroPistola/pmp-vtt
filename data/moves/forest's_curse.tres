description = "Você convoca a energia da floresta para alterar o tipo de outra criatura. Role 1d20 + MOVE + 9 e compare o resultado com 10 + CAR do alvo. Em um resultado maior ou igual, Forest's Curse adiciona o tipo Grama ao alvo. Se o alvo já for de tipo duplo, ele se torna um Pokémon de três tipos. Se o alvo estiver sob o efeito d e Trick-or-Treat, o tipo Fantasma é substituído pelo tipo Grama."
range_text_raw = "(9 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([4, 5])
