has_status_roll = true
status_roll_bonus = 9
status_roll_target_attribute = 1
description = "Você se move rapidamente para tentar trocar itens segurados com uma criatura. Role 1d20 + MOVE  + 9 e compare o resultado com 10 + DES do alvo. Em um resultado maior ou igual, você pega o item segurado pelo alvo e o substitui pelo seu próprio. Caso não este ja segurando um item, você apenas pega o item do alvo. Caso o alvo não esteja segurando um item, você pode entregar a ele um item que esteja segurando. Observações: A Griseous Orb não pode ser removida de Giratina; as Type Plates não podem ser removidas d e Arceus; os Drives não podem ser removidos de Genesect; e as Mega Pedras não podem ser removidas de seus respectivos Pokémon . Trick não pode ser escolhido pelo Move Assist."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([4])
