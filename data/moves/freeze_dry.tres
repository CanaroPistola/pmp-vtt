range_category = 2
range_distance = 6.0
description = "Você libera um ar extremamente frio que rapidamente resfria uma criatura em alcance. Faça um ataque à distância em uma criatura, causando 2d8 + MOVE de dano de gelo em um acerto. Em um resultado natural de 19 ou 20 no acerto, o alvo fica congelado. Este Move causa dano super efetivo a criaturas do tipo água. Se o alvo tiver um segundo tipo resistente ao dano de gelo, este Move causa dano padrão. Já se o segundo tipo for vulnerável ao dano de gelo, o dano é quadruplicado."
scaling_text = "Os dados de dano para este Move mudam para 1d20 no nível 5, 3d10 no nível 10 e 3d12 no nível 17."
range_text_raw = "(6 metros)"
duration_text_raw = "Instantânea"
