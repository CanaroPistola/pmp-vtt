move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você avança com um ataque incrível de presa. Faça um ataque corpo a corpo -1 contra um alvo. Em um acerto, você causa dano igual à metade dos pontos de vida atuais do alvo (até um máximo de 5x seu nível). A imunidade de tipo não é ignorada, então Super Fang não afeta Pokémon do tipo Fantasma . Esse dano não pode ser aumentado ou reduzido por nenhuma fonte, incluindo STAB, itens,  condições, habilidades (de Pokémon ou Treinador), outros Moves ou acertos críticos."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
