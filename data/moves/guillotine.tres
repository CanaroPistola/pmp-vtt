id = "guillotine"
display_name = "Guillotine (Guilhotina)"
name_en = "Guillotine"
name_pt = "Guilhotina"
pp = 3
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você é preenchido com uma raiva imensurável, agarrando a cabeça de uma criatura na tentativa de espremer a vida dela. Faça um ataque corpo a corpo contra um alvo. Em um acerto, role um d20. Em um resultado de 15 ou mais, você faz a criatura desmaiar instantaneamente. Em qualquer outro resultado, este Move não tem efeito. Para cada 2 níveis em que você estiver acima do alvo, aumente em +1 a margem de acerto no efeito do d20 deste Move. Caso use em um alvo de nível maior que o seu, o ataque falha automaticamente."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
