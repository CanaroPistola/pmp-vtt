id = "belly_drum"
display_name = "Belly Drum (Tambor de Barriga)"
name_en = "Belly Drum"
name_pt = "Tambor de Barriga"
pp = 5
move_time = "1 ação"
range_category = 0
range_distance = 0.0
duration_is_permanent = true
description = "Você golpeia seu próprio corpo, aumentando seu poder de ataque à custa de sua resistência. Ao usar este Move, você perde 50% dos seus pontos de vida máximos (arredondado para baixo), mas seu Ataque aumenta ao máximo (6 estágios). Belly Drum falha se os pontos de vida atuais do usuário forem menores que a metade de seus pontos de vida máximos, ou se o Ataque do usuário já estiver aumentado ao máximo (6 estágios), mesmo se o usuário tiver Contrary."
range_text_raw = "Pessoal"
duration_text_raw = "Enquanto ativo"
effect_tags = Array[String](["stat_change"])
