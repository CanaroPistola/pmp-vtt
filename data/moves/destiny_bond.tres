[resource]
script = ExtResource("1_oji7u")
id = "destiny_bond"
display_name = "Destiny Bond"
name_en = "Destiny Bond"
type = 13
pp = 3
move_time = "1 reação"
activation = 1
range_category = 2
range_distance = 15.0
duration_rounds = 1
description = "Você cria um vínculo interno obscuro com uma criatura. Ao ser atingido por um Move danoso, antes de saber o dano causado, ou antes de fazer um teste de resistência, você pode usar sua reação para criar uma conexão com o atacante. Até o início de seu próximo turno, se você desmaiar devido a um ataque desta criatura, o alvo também desmaia. Caso o alvo seja de nível acima do seu, ao invés de desmaiar, ele apenas recebe dano sem tipo igual à sua vida restante antes de desmaiar. Ao fazer isso, você abre mão de sua ação padrão em seu próximo turno . Destiny Bond não é ativado por dano indireto, como dano de clima, Leech Seed ou Future Sight. Este Move sempre falha se tiver sido usado na rodada anterior. O Pokémon que usou Destiny Bond sempre desmaia primeiro, e o atacante desmaia depois. Isso significa que, se ambos forem os últimos Pokémon de seus times, o oponente vence a batalha. Observações: Destiny Bond não pode ser escolhido pelo Move Assist."
range_text_raw = "(15 metros)"
duration_text_raw = "1 rodada"
