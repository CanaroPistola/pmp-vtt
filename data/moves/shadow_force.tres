[resource]
script = ExtResource("1_kkltn")
id = "shadow_force"
display_name = "Shadow Force (Força Sombria)"
name_en = "Shadow Force"
name_pt = "Força Sombria"
type = 13
pp = 3
move_time = "1 ação"
is_attack = true
resolution = 1
needs_charge = true
range_category = 7
range_distance = 12.0
range_secondary = 1.5
duration_rounds = 1
duration_flags = Array[String](["charge"])
description = "Você desaparece em sombras e surge atrás do inimigo para golpeá-lo de surpresa. Quando você ativa este Move, você desaparece, permanecendo em um estado invulnerável até o seu próximo turno. Durante este tempo, você é imune ao dano e efeitos de qualquer Move. No seu próximo turno, como uma ação, você pode reaparecer em um espaço desocupado dentro do alcance do Move, ou reaparecer por trás de uma criatura dentro do alcance (a partir do ponto em que usou o Move), desferindo um ataque corpo a corpo com vantagem, causando 3d8 + MOVE de dano fantasma em um acerto bem-sucedido. Este Move ignora reações de proteção, como Protect ou Detect. Se o alvo tiver Visão Verdadeira, o ataque não é rolado na vantagem. Caso o alvo saia do alcance estabelecido no momento em que o Move foi ativado, ele ainda pode ser atingido por esse Move, independente da distância que tenha percorrido."
scaling_text = "Os dados de dano para este Move mudam para 6d6 no nível 5, 6d8 no nível 10 e 6d10 no nível 17."
range_text_raw = "Corpo a corpo / (12 metros)"
duration_text_raw = "1 rodada, carga"
role = 0
move_power_attributes = Array[int]([1, 4])
