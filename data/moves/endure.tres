[resource]
script = ExtResource("1_vce8m")
id = "endure"
display_name = "Endure"
name_en = "Endure"
pp = 5
move_time = "1 reação"
activation = 1
range_category = 0
range_distance = 0.0
duration_rounds = 1
description = "Você se mantém forte perante um golpe fatal. Caso você receba dano que o faria desmaiar, você pode, em vez disso , cair para 1 PV automaticamente ao receber o dano, e se manterá assim mesmo ao receber qualquer outro dano até o início de seu próximo turno. Caso faça isso, você abre mão de sua ação padrão em seu próximo turno. Se na rodada anterior você tiver usado Endure ou algum dos Moves Protect, Detect, Wide Guard, Quick Guard, Spiky Shield, King's Shield, Baneful Bunker, Burning Bulwark, Max Guard, Obstruct ou Silk Trap, role 1d6 para cada uso consecutivo bem - sucedido desses Moves, até o máximo de 6d6. Este Move só é bem- sucedido se todos os dados rolados resultarem em 5 ou 6. Observações: Endure não pode ser escolhido pelo Move Assist."
range_text_raw = "Pessoal"
duration_text_raw = "Até o início do próximo turno"
