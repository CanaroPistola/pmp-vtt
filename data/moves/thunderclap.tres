range_category = 2
range_distance = 30.0
description = "Você ataca antes do alvo com uma descarga elétrica súbita e estrondosa. Quando alvo de um Move danoso, você pode usar sua reação para tentar atacar uma criatura antes que seu dano seja rolado. Faça um ataque à distância contra o atacante, causando 2d8 + MOVE de dano do tipo Elétrico em um acerto. Ao fazer isso, você abre mão de sua ação padrão em seu próximo turno. Este Move é classificado como Prioridade 1. Caso outra criatura utilize um Move de Prioridade 1 no mesmo momento, a ordem de execução é determinada pela Destreza (ou por uma rolagem, em caso de empate). Moves com valores mais altos de Prioridade são sempre executados antes. Thunderclap não é afetado por nenhuma condição que o impeça de ser executado, como sono ou congelamento, ou a habilidade Truant."
scaling_text = "Os dados de dano para este Move mudam para 2d10 no nível 5, 3d10 no nível 10 e 3d12 no nível 17."
range_text_raw = "(30 metros)"
duration_text_raw = "Instantânea"
