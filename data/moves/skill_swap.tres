id = "skill_swap"
display_name = "Skill Swap"
name_en = "Skill Swap"
type = 10
pp = 5
move_time = "1 ação"
resolution = 4
has_status_roll = true
status_roll_bonus = 9
range_category = 2
range_distance = 15.0
duration_is_permanent = true
description = "Você tenta trocar sua habilidade passiva com a de uma criatura dentro do alcance. Role 1d20 + MOVE + 9 e compare o resultado com 10 + SAB do alvo. Em um resultado maior ou igual, você troca sua habilidade passiva com a do alv o. Habilidades passivas têm seus efeitos ativados novamente e imediatamente ao serem trocadas dessa maneira. Caso o Pokémon afetado por Skill Swap seja retirado de campo, ele recupera sua habilidade original. Observações: Este Move ignora Substitute."
range_text_raw = "(15 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([4])
