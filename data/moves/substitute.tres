[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_whntv"]

[resource]
script = ExtResource("1_whntv")
id = "substitute"
display_name = "Substitute (Substituição)"
name_en = "Substitute"
name_pt = "Substituição"
pp = 5
move_time = "1 ação"
range_category = 0
range_distance = 0.0
duration_is_permanent = true
description = "Você sacrifica 25% dos seus PV máximos (arredondados para baixo) para criar um escudo com a mesma quantidade de PV temporários. Enquanto este escudo estiver ativo, ele absorve todo o dano causado por fontes externas que normalmente afetariam você. Além disso, ele concede imunidade a condições negativas (como paralisia, queimadura, atordoamento, confusão, caído, impedido, entre outras) e impede a redução de Mudança de Status por efeitos externos. O escudo é considerado sem tipo para fins de resistências, vulnerabilidades e imunidades. O escudo e o usuário não podem ser curados enquanto ele estiver ativo, e ele não absorve efeitos ou danos causados por fontes internas, como confusão, veneno ou queimadura pré-existentes. O escudo se quebra quando for reduzido a 0 pontos de vida, e qualquer dano excedente é dissipado. Moves baseados em som ignoram o escudo."
range_text_raw = "Pessoal"
duration_text_raw = "Enquanto ativo"
effect_tags = Array[String](["shield"])
