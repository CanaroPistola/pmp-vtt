description = "Você tenta encantar uma criatura do gênero oposto ao alcance para que ela diminua a força de seus golpes. Role 1d20 + MOVE + 9 e compare o resultado com 10 + CAR do alvo. Em um resultado maior ou igual, o alvo tem seu Ataque Especial reduzido em 2 estágios, podendo ser acumulado em até -6 estágios. Captivate falhará se ambos os Pokémon forem do mesmo gênero, se algum deles não tiver gênero ou se o alvo tiver a habilidade Oblivious."
range_text_raw = "(12 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([4, 5])
effect_tags = Array[String](["stat_change"])
