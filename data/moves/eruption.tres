move_time = "1 ação"
resolution = 2
has_save = true
range_category = 2
range_distance = 18.0
description = "Você gera uma explosão massiva e intensa de fogo e magma que jorram de seu corpo. Qualquer criatura em um círculo de 6 metros de raio, centrado em um ponto dentro do alcance, deve fazer um teste de resistência de DES contra sua CD de Move, sofrendo 5d6 + MOVE de dano de fogo em uma falha, ou metade disso em um sucesso. Este Move causa dano máximo apenas quando o usuário está com 100% de seus Pontos de Vida. Ao perder qualquer quantidade de vida, reduza em 1 o número de dados de dano rolados. Além disso, para cada 25% da vida máxima perdida, reduza em mais 1 dado de dano."
scaling_text = "Os dados de dano para este Move mudam para 5d8 no nível 5, 6d10 no nível 10 e 6d12 no nível 17."
range_text_raw = "(18 metros)"
duration_text_raw = "Instantânea"
