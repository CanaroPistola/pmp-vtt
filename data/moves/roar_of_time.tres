move_time = "1 ação, recarga"
resolution = 2
has_save = true
save_attribute = 4
needs_recharge = true
range_category = 5
range_distance = 12.0
description = "Você solta um rugido que tem o poder de distorcer o tempo. Todas as criaturas dentro de 40 pés (12 metros) de você devem fazer um teste de resistência de SAB contra sua CD de Move -1, sofrendo 5d6 + MOVE de dano do tipo dragão em uma falha, ou metade disso em um sucesso. Para qualquer criatura que falhar no teste por 5 ou mais, você pode imediatamente realizar outra ação contra elas. Roar of Time não pode ser usado como uma das ações adicionais. Este Move drena sua energia, e você não pode realizar outra ação padrão ou reação até o final do seu próximo turno."
scaling_text = "Os dados de dano para este Move mudam para 5d8 no nível 5, 6d10 no nível 10 e 6d12 no nível 17."
range_text_raw = "Pessoal (raio de 12 metros)"
duration_text_raw = "Instantânea"
role = 0
