range_distance = 4.5
description = "Você suga a força vital de uma criatura dentro do alcance, drenando sua energia para se revitalizar. Role 1d20 + MOVE + 9 e compare o resultado com 10 + CON do alvo. Em um resultado maior ou igual, o Ataque do alvo é reduzido em 1 estágio, podendo ser acumulado em até -6 estágios, e você recupera uma quantidade de pontos de vida igual ao valor puro de Força do alvo -1 para cada estágio de Ataque negativo (antes de aplicar)."
range_text_raw = "(4,5 metros)"
duration_text_raw = "Instantânea"
