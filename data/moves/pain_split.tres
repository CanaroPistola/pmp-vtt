[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_qbgsg"]

[resource]
script = ExtResource("1_qbgsg")
id = "pain_split"
display_name = "Pain Split"
name_en = "Pain Split"
move_time = "1 ação"
resolution = 4
has_status_roll = true
status_roll_bonus = 9
status_roll_target_attribute = 2
range_category = 2
range_distance = 9.0
description = "ocê divide a dor dos seus ferimentos com uma criatura dentro do alcance. Role 1d20 + MOVE + 9 e compare o resultado com 10 + CON do alvo. Em um resultado maior ou igual, você e o alvo alteram seus pontos de vida atuais para a média entre os pontos de vida atuais dos dois, arredondada para baixo. Se isso fizer com que qualquer criatura ultrapasse seu máximo de pontos de vida, ela fica com seu máximo de pontos de vida em vez disso. O máximo de pontos de vida que um alvo pode perder com este Move é igual a 5 vezes o seu nível atual."
range_text_raw = "(9 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([2, 5])
