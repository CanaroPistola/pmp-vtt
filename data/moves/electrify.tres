range_distance = 15.0
range_secondary = 1.5
description = "Você rapidamente lança uma descarga elétrica em um atacante, transformando seu Move usado em tipo elétrico. Quando qualquer criatura utilizar um Move dentro do alcance, você pode imediatamente usar sua reação para realizar um ataque corpo a corpo ou à distância contra o alvo (com acerto garantido em um aliado, desde que você possa vê -lo e ele esteja  dentro do seu alcance). Em um acerto, o tipo do Move é alterado para elétrico. Ao fazer isso, você abre mão de sua ação padrão em seu próximo turno. Observações: Electrify não afeta Struggle."
range_text_raw = "Corpo a Corpo (15 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([0, 1])
