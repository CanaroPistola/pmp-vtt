range_distance = 9.0
description = "Você cria uma rajada poderosa de vento que lança o inimigo para longe. O alvo deve realizar um teste de resistência de FOR contra sua CD de Move. Em caso de falha, o efeito depende do tipo de encontro. Em encontros selvagens: Se o alvo for de um nível menor que você, ele tenta fugir do combate imediatamente. Em batalhas contra treinadores: O alvo é imediatamente substituído por outro Pokémon da equipe, à escolha do treinador. Se não houver outro Pokémon disponível, ou se o alvo estiver impossibilitado de ser trocado (por habilidade, item ou condição de combate), o Move falha automaticamente. Este Move ignora reações de proteção, como Protect ou Detect."
range_text_raw = "(9 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([1])
