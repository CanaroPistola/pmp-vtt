id = "supercell_slam"
display_name = "Supercell Slam"
name_en = "Supercell Slam"
type = 3
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você eletrifica todo o corpo e despenca violentamente sobre o alvo. Faça um ataque corpo a corpo -1 contra um alvo, causando 2d10 + MOVE de dano do tipo Elétrico em um acerto. Caso falhe, você sofre o dobro do dano que causaria no ataque (não contando com suas Mudanças de Status). Se o alvo for imune a Supercell Slam por tipo ou habilidade, como Volt Absorb, ou estiver protegido, o Move conta como falha. Se o alvo tiver usado Minimize, Supercell Slam causa um acerto garantido e o dobro dos dados de dano, desde que você possa vê-lo e ele esteja dentro do seu alcance (mas role um d20 para chance de golpe crítico e outros efeitos)."
scaling_text = "Os dados de dano para este Move mudam para 5d6 no nível 5, 5d8 no nível 10 e 5d10 no nível 17."
range_text_raw = "Corpo a Corpo"
duration_text_raw = "Instantânea"
