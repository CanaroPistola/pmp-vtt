[resource]
script = ExtResource("1_qpwsm")
id = "phantom_force"
display_name = "Phantom Force (Golpe Fantasma)"
name_en = "Phantom Force"
name_pt = "Golpe Fantasma"
type = 13
pp = 5
move_time = "1 ação"
is_attack = true
resolution = 1
range_category = 7
range_distance = 12.0
range_secondary = 1.5
description = "Quando você ativa este Move, você desaparece em um portal sob seus pés, permanecendo em um estado invulnerável até o seu próximo turno. Durante este tempo, você é imune ao dano e aos efeitos de qualquer Move. No seu próximo turno, como uma ação, você pode reaparecer em um espaço desocupado dentro do alcance do Move, ou reaparecer por trás de uma criatura dentro do alcance (a partir do ponto em que usou o Move), desferindo um ataque corpo a corpo com vantagem, causando 3d6 + MOVE de dano fantasma em um acerto bem-sucedido. Este Move ignora reações de proteção (como Protect ou Detect). Se o alvo tiver Visão Verdadeira, o ataque não é rolado na vantagem. Caso o alvo saia do alcance estabelecido no momento em que o Move foi ativado, ele ainda pode ser atingido por esse Move, independente da distância que tenha percorrido."
scaling_text = "Os dados de dano para este Move mudam para 3d10 no nível 5, 3d12 no nível 10 e 4d12 no nível 17."
range_text_raw = "Corpo a corpo / (12 metros)"
duration_text_raw = "Instantânea"
role = 0
move_power_attributes = Array[int]([1, 4])
has_damage = true
