[resource]
script = ExtResource("1_dmbcj")
id = "light_screen"
display_name = "Light Screen (Tela de Luz)"
name_en = "Light Screen"
name_pt = "Tela de Luz"
type = 10
pp = 15
move_time = "1 ação"
range_category = 5
range_distance = 4.5
duration_rounds = 5
description = "Placas luminosas e semitransparentes se formam no ar ao redor do usuário. Pela duração, você recebe apenas metade do dano causado por ataques à distância. Você também pode ampliar o escudo para proteger aliados dentro do alcance, porém, caso faça isso, tanto você quanto eles receberão apenas 1/3 da redução de dano de ataques à distância, ao invés de metade do dano. Light Screen não surte efeito contra um ataque crítico ou certos Moves específicos."
range_text_raw = "Pessoal / raio de (4,5 metros)"
duration_text_raw = "5 rodadas"
