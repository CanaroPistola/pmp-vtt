description = "Você usa seu poder psíquico para trocar a velocidade com uma criatura. Force uma criatura no alcance a fazer um teste de CAR contra sua CD de Move. Em caso de falha, todas as velocidades de movimentação compatíveis entre os dois serão trocadas, e suas posições na iniciativa também. Este Move não troca modificadores de Velocidade em combate, como Habilidades e Mudanças de Status."
range_text_raw = "(12 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([4, 3])
