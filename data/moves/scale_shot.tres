id = "scale_shot"
display_name = "Scale Shot"
name_en = "Scale Shot"
type = 14
move_time = "1 ação"
is_attack = true
resolution = 1
range_category = 2
range_distance = 12.0
description = "Você sacrifica suas escamas naturais para realizar um ataque, ficando mais leve, porém mais vulnerável. Faça um ataque à distância -1 em uma criatura, causando 1d4 + MOVE de dano dragão em um acerto. Em um acerto, após isso, role um d8 e compare o resultado com a tabela abaixo para determinar a quantidade de golpes. Para cada golpe adicional, você pode imediatamente realizar um novo ataque contra o mesmo alvo com acerto garantido, causando 1d4 + MOVE de dano dragão. Cada golpe extra deve rolar separadamente um d20 para verificar chance de crítico, mas não para efeitos secundários de habilidades ou itens. Após realizar todos os golpes, sua Velocidade aumenta 1 estágio e sua Defesa diminui 1 estágio, podendo acumular até +6 e -6 estágios, respectivamente. Confira a tabela no livro."
scaling_text = "Os dados de dano para este Move mudam para 1d8 no nível 5, 1d10 no nível 10 e 2d6 no nível 17."
range_text_raw = "(12 metros)"
duration_text_raw = "Instantânea"
