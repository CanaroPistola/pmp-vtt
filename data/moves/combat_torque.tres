move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você parte para cima do alvo com força bruta e liberando uma onda de impacto no momento do choque. Faça um ataque corpo a corpo, causando 2d10 + MOVE de dano do tipo lutador em um acerto. Em um resultado natural de 15 ou mais no acerto, o alvo fica Paralisado. Este Move não aciona efeitos de inimigos que se ativam ao contato corpo a corpo. Observações: Encore, Instruct, Mimic e Sketch falham se o último Move usado pelo alvo foi Combat Torque. Copycat falha se o último Move usado foi Combat Torque."
scaling_text = "Os dados de dano para este Move mudam para 5d6 no nível 5, 5d8 no nível 10 e 5d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
