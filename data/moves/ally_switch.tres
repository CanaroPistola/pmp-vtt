[resource]
script = ExtResource("1_nvjtg")
id = "ally_switch"
display_name = "Ally Switch"
name_en = "Ally Switch"
type = 10
move_time = "1 ação / reação"
activation = 3
range_category = 2
range_distance = 15.0
description = "Você usa um estranho poder psíquico para se teletransportar a uma criatura voluntária no alcance, usando sua ação para trocar de lugar com ela no campo de batalha. Você também pode usar este Move como uma reação quando algum aliado em alcance estiver prestes a sofrer um ataque , trocando de lugar e recebendo este golpe no lugar dele. Ao fazer isso, você abre mão de sua ação em seu próximo turno."
range_text_raw = "(15 metros)"
duration_text_raw = "Instantânea"
