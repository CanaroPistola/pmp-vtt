move_time = "1 ação"
is_attack = true
resolution = 1
range_category = 2
range_distance = 9.0
duration_rounds = 3
description = "Você lança ondas psíquicas no ar que se manifestarão atingindo um alvo em um momento futuro. Ao usar este Move, escolha um alvo dentro do alcance. O ataque será desferido automaticamente no início do turno do alvo na terceira rodada após o uso (a rodada atual conta como a primeira). Quando chegar este momento, faça um ataque à distância, causando 3d8 + MOVE de dano psíquico em um acerto, mesmo que o alvo tenha saído do alcance do Move. Caso o alvo seja trocado, o Pokémon que o substituiu receberá este ataque. Future Sight não pode ser interrompido por Moves de proteção (como Protect ou Detect), Endure ou pela habilidade Wonder Guard."
scaling_text = "Os dados de dano para este Move mudam para 6d6 no nível 5, 6d8 no nível 10 e 6d10 no nível 17."
range_text_raw = "(9 metros)"
duration_text_raw = "3 rodadas"
