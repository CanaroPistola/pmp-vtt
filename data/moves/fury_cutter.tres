id = "fury_cutter"
display_name = "Fury Cutter (Corte Furioso)"
name_en = "Fury Cutter"
name_pt = "Corte Furioso"
type = 11
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você desencadeia uma série de cortes contra uma criatura que aumentam em força. Quando você ativa este Move, faça um ataque corpo a corpo -1 em um alvo em alcance, causando 2d4 + MOVE de dano inseto em um acerto. Se você usar este Move em seu turno em rodadas consecutivas, dobre os dados de dano a cada acerto. O multiplicador tem um limite máximo de 4x o dano original. O dano é resetado se algum dos ataques falhar, ou se você estiver incapacitado."
scaling_text = "Os dados de dano para este Move mudam para 1d12 no nível 5, 4d4 no nível 10 e 2d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
