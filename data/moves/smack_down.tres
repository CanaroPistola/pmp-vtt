[resource]
script = ExtResource("1_g0hsg")
id = "smack_down"
display_name = "Smack Down (Derrubada)"
name_en = "Smack Down"
name_pt = "Derrubada"
type = 12
move_time = "1 ação"
is_attack = true
resolution = 1
range_category = 2
range_distance = 24.0
description = "Você lança uma esfera de energia sólida como pedra em uma criatura na tentativa de derrubá-la. Faça um ataque à distância, causando 1d10 + MOVE de dano de pedra em um acerto. Em um acerto, qualquer criatura 'Elevada' é derrubada ao chão, ficando caída, e perde sua velocidade de voo e imunidade a Moves do tipo terra até que possa se mover novamente. Pokémon elevados são quaisquer do tipo Voador, aqueles sob os efeitos de Levitate, Magnet Rise, Telekinesis ou por segurarem um Air Balloon. Smack Down pode atingir Pokémon que estiverem usando Fly ou Bounce, caso tenham sido ativados dentro do alcance, e irá trazê-los de volta ao chão, cancelando esses Moves. Também pode atingir Pokémon que estiverem usando Sky Drop, mas não os derruba ao chão."
scaling_text = "O dado de dano para este Move muda para 2d8 no nível 5, 2d10 no nível 10 e 4d6 no nível 17."
range_text_raw = "(24 metros)"
duration_text_raw = "Instantânea"
