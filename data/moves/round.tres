move_time = "1 ação / reação"
resolution = 2
has_save = true
save_attribute = 4
activation = 3
range_category = 2
range_distance = 12.0
description = "Você solta uma melodia ressonante que toma forma em ondas sonoras coloridas, amplificando-se quando mais vozes se unem ao canto. Selecione um alvo no alcance e force-o a fazer um teste de resistência de SAB contra sua CD de Move. Em uma falha, o alvo sofre 2d6 + MOVE de dano normal. Se um aliado ao seu alcance e no alcance do alvo também conhecer este Move, ele pode se juntar à canção como uma reação para dobrar os dados de dano, abrindo mão da ação dele no próximo turno. Não é possível acumular mais de 2 usuários neste Move. Observações: Round é um Move baseado em som."
scaling_text = "Os dados de dano para este Move mudam para 3d6 no nível 5, 3d8 no nível 10 e 5d6 no nível 17."
range_text_raw = "(12 metros)"
duration_text_raw = "Instantânea"
