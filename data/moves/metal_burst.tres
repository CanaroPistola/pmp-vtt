[resource]
script = ExtResource("1_t4b4a")
id = "metal_burst"
display_name = "Metal Burst (Explosão Metálica)"
name_en = "Metal Burst"
name_pt = "Explosão Metálica"
type = 16
pp = 5
move_time = "1 reação"
is_attack = true
resolution = 1
activation = 1
range_category = 2
range_distance = 12.0
description = "Você absorve o poder do ataque do oponente, e devolve como uma esfera de energia metálica a ele. Após você ser atingido por um Move danoso, você pode usar sua reação para desferir um ataque à distância contra a criatura, causando 1,5x do dano recebido como dano do tipo aço em caso de acerto (máximo de 5 vezes o seu nível atual). Caso faça isso, você abre mão de sua ação em seu próximo turno. Metal Burst só reflete o último golpe de Moves com múltiplos golpes e não reflete ataques absorvidos por Substitute."
range_text_raw = "(12 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([0, 1])
