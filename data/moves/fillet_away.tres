move_time = "1 ação"
range_category = 0
range_distance = 0.0
description = "Você se debate furiosamente, dilacerando o próprio corpo para aumentar drasticamente suas capacidades de luta. Ao usar este Move, você perde 50% dos seus pontos de vida máximos (arredondado para baixo), mas seu Ataque, Ataque Especial e Velocidade aumentam em 2 estágios, podendo ser acumulados em até 6 estágios. Fillet Away falha se os pontos de vida atuais do usuário forem menores que a metade de seus pontos de vida máximos."
range_text_raw = "Pessoal"
duration_text_raw = "Instantânea"
effect_tags = Array[String](["stat_change"])
