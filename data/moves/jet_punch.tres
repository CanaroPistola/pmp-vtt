[resource]
script = ExtResource("1_e3ov3")
id = "jet_punch"
display_name = "Jet Punch"
name_en = "Jet Punch"
type = 2
move_time = "1 ação / reação"
is_attack = true
resolution = 1
activation = 3
description = "Você envolve o punho em um jato de água e desfere um soco em velocidade extrema. Como uma ação, você pode se mover imediatamente até 15 pés (4,5 metros) sem provocar ataques de oportunidade, e realizar um ataque corpo a corpo contra uma criatura ao alcance, causando 2d6 + MOVE de dano do tipo Água em um acerto. Este Move também pode ser usado como reação, podendo ser ativado em qualquer momento da rodada, desde que ocorra fora do turno de outra criatura (após um turno ser encerrado e antes da próxima criatura agir) e antes do início do seu próximo turno. Se usar esta reação, você perde a ação padrão do seu próximo turno. Este Move é classificado como Prioridade 1. Caso outra criatura utilize um Move de Prioridade 1 no mesmo momento, a ordem de execução é determinada pela Destreza (ou por uma rolagem, em caso de empate). Moves com valores mais altos de Prioridade são sempre executados antes."
scaling_text = "A partir do nível 10, você também pode utilizar este Move como uma ação bônus. Os dados de dano para este Move mudam para 3d6 no nível 5, 3d8 no nível 10 e 5d6 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
role = 0
move_power_attributes = Array[int]([0, 1])
has_damage = true
damage_by_level = {
1: {
"amount": 2,
"dice_max": 6,
"move": true
},
