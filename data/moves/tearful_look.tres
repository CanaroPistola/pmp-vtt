[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_l0sil"]

[resource]
script = ExtResource("1_l0sil")
id = "tearful_look"
display_name = "Tearful Look"
name_en = "Tearful Look"
move_time = "1 reação / ação"
resolution = 4
has_status_roll = true
status_roll_bonus = 9
status_roll_target_attribute = 5
activation = 3
range_category = 2
range_distance = 15.0
duration_is_permanent = true
description = "Você enche os olhos de lágrimas para fazer com que uma criatura dentro do alcance perca seu espírito combativo. Quando você for alvo de um ataque corpo a corpo ou à distância de alvo único, pode usar sua reação para usar este Move contra o atacante. Role 1d20 + MOVE + 9 e compare o resultado com 10 + CAR do alvo. Em um resultado maior ou igual, o Ataque e Ataque Especial do alvo são reduzidos em 1 estágio, podendo ser acumulados em até -6 estágios. Essa redução ocorre antes do dano ser causado. Caso use este Move como reação e o efeito seja aplicado, você perde sua ação no próximo turno . Você também pode usar este M ove como uma ação em seu turno para causar o mesmo efeito. Observações: Tearful Look ignora Moves de proteção como Protect e Detect, mas será bloqueado por Crafty Shield."
range_text_raw = "(15 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([4, 5])
effect_tags = Array[String](["stat_change"])
