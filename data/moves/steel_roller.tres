id = "steel_roller"
display_name = "Steel Roller"
name_en = "Steel Roller"
type = 16
pp = 3
move_time = "1 ação"
is_attack = true
resolution = 1
range_category = 4
range_distance = 6.0
description = "Você sai rolando de maneira desastrosa, destruindo todo o terreno ao redor. Este Move não funciona caso seja ativado fora de um Terreno (Grassy Terrain, Misty Terrain, Electric Terrain ou Psychic Terrain). Avance obrigatoriamente 20 pés (6 metros) em linha reta sem sofrer ataques de oportunidade, e realize um ataque corpo a corpo contra cada criatura no trajeto, causando 4d6 + MOVE de dano do tipo aço em cada acerto. Se atingir um alvo que seja duas ou mais escalas de tamanho maior que a sua, você ricocheteia ao colidir, continuando o movimento na direção oposta do golpe. Durante este Move, cada criatura só pode sofrer dano uma única vez, mesmo que seja atingida novamente no trajeto. Ao ativar este Move, o terreno é desfeito imediatamente."
scaling_text = "Os dados de dano para este Move mudam para 2d20 no nível 5, 5d10 no nível 10 e 8d8 no nível 17."
range_text_raw = "Corpo a corpo linha de (6 metros)"
duration_text_raw = "Instantânea"
role = 0
