[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_p0bud"]

[resource]
script = ExtResource("1_p0bud")
id = "spiky_shield"
display_name = "Spiky Shield"
name_en = "Spiky Shield"
type = 4
pp = 5
move_time = "1 reação"
activation = 1
duration_rounds = 1
description = "Você ergue rapidamente um escudo pontiagudo para se proteger de danos. Quando você é alvo direto do dano e/ou efeitos de um Move de alvo único, você pode usar sua reação para evitar automaticamente o dano e efeitos desse e de qualquer outro Move de alvo único direcionado a você até o início de seu próximo turno . Caso faça isso, você abre mão de sua ação padrão em seu próximo turno. Se algum ataque corpo a corpo for direcionado a você durante o efeito do Spiky Shield, o atacante recebe dano sem tipo igual ao nível dele. Se na rodada anterior você tiver usado Spiky Shield ou algum dos Moves Protect, Detect, Endure, Wide Guard, Quick Guard, Spiky Shield, King's Shield, Baneful Bunker, Burning Bulwark, Max Guard, Obstruct ou Silk Trap, role 1d6 para cada uso consecutivo bem-sucedido desses Moves, até o máximo de 6d6. Este Move só é bem-sucedido se todos os dados rolados resultarem em 5 ou 6. Observações: Spiky Shield não pode ser escolhido pelo Move Assist."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Até o início do próximo turno"
effect_tags = Array[String](["protect"])
