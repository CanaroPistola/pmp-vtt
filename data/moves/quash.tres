description = "Você envia energia sombria contra uma criatura dentro do alcance, reduzindo sua vontade de lutar. Escolha um alvo que ainda não tenha agido nesta rodada. Role 1d20 + MOVE + 9 e compare o resultado com 10 + SAB do alvo. Em um resultado maior ou igual, o alvo se move para o final da ordem de iniciativa apenas nesta rodada. Alvos que já tenham agido nesta rodada não são afetados. Observações: O efeito de Quash é ignorado por After You , e não é afetado por Trick Room."
range_text_raw = "(9 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([0, 4])
