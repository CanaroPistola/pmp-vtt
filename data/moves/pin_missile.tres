range_distance = 18.0
description = "Você atinge uma criatura com projéteis afiados em rápida sucessão. Faça um ataque à distância -1 em uma criatura, causando 1d4 + MOVE de dano inseto em um acerto. Em um acerto, após isso, role um d8 e compare o resultado com a tabela abaixo para determinar a quantidade de golpes. Para cada golpe adicional, você pode imediatamente realizar um novo ataque contra o mesmo alvo com acerto garantido, causando 1d4 + MOVE de dano inseto. Cada golpe extra deve rolar separadamente 1d20 para verificar chance de crítico. Confira a tabela no livro."
scaling_text = "O dado de dano para esse Move muda para 1d8 no nível 5, 1d10 no nível 10 e 2d6 no nível 17."
range_text_raw = "(18 metros)"
duration_text_raw = "Instantânea"
