name_en = "Spikes"
type = 8
move_time = "1 ação"
range_category = 2
range_distance = 15.0
target_area_radius = 6.0
description = "Você rapidamente espalha uma camada de espinhos pontiagudos no chão em um raio de 20 pés (6 metros), centrado em um ponto dentro do alcance. Sempre que uma criatura entrar nessa área, ou quando um Pokémon for substituído e o próximo surgir dentro dela, a criatura sofre dano sem tipo igual ao nível dela. Mover-se dentro da área é considerado terreno difícil. Uma criatura pode ignorar essa penalidade ao atravessar os espinhos, mas recebe dano ao fazer isso . Você pode usar uma ação para fortalecer a área. Cada vez que fizer isso, aumente o raio da área em mai s 10 pés (3 metros), e o dano em mais 50% do valor original, até um máximo de 2 vezes (o dobro do nível do alvo). Um mesmo Pokémon pode manter até duas áreas de Spikes ativas simultaneamente. Caso tente criar uma terceira, a mais antiga desaparece automaticamente. Pokémon elevados não sofrem o efeito deste Move. Pokémon elevados são quaisquer do tipo Voador, aqueles sob os efeitos de Levitate, Eelevate, Magnet Rise, Telekinesis ou por segurarem um Air Balloon."
range_text_raw = "(15 metros)"
duration_text_raw = "Instantânea"
effect_tags = Array[String](["hazard"])
