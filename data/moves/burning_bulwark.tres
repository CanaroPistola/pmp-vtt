[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_7e3ag"]

[resource]
script = ExtResource("1_7e3ag")
id = "burning_bulwark"
display_name = "Burning Bulwark"
name_en = "Burning Bulwark"
type = 1
pp = 5
move_time = "Reação"
activation = 1
range_category = 0
range_distance = 0.0
duration_rounds = 1
description = "Seu pelo extremamente quente protege você dos ataques. Quando você é alvo direto do dano e/ou efeitos de um Move de alvo único, você pode usar sua reação para evitar automaticamente o dano e efeitos desse e de qualquer outro Move de alvo único direcionado a você até o início de seu próximo turno. Caso faça isso, você abre mão de sua ação padrão em seu próximo turno. Se algum ataque corpo a corpo acertar você durante o efeito do Burning Bulwark, o atacante fica queimado. Se na rodada anterior você tiver usa do Burning Bulwark ou algum dos Moves Protect, Detect, Endure, Spiky Shield, Wide Guard, Quick Guard, King's Shield, ou Baneful Bunker, role 1d6 para cada uso consecutivo bem-sucedido desses Moves, até o máximo de 6d6. Este Move só é bem -sucedido se todos os dados rolados resultarem em 5 ou 6."
range_text_raw = "Pessoal"
duration_text_raw = "Até o início do próximo turno"
effect_tags = Array[String](["protect", "burn"])
