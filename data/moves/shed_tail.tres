[resource]
script = ExtResource("1_ancao")
id = "shed_tail"
display_name = "Shed Tail"
name_en = "Shed Tail"
pp = 5
move_time = "1 ação"
range_category = 0
range_distance = 0.0
description = "Você sacrifica parte da própria cauda para criar uma distração, deixando-a em campo enquanto recua. Você sacrifica metade dos seus PV máximos (arredondados para cima) para criar um escudo com 1/4 de seus PV máximos, e imediatamente retorna à Pokébola, devendo ser trocado com outro Pokémon de seu Treinador. O Pokémon que substituí-lo recebe esse escudo. Enquanto este escudo estiver ativo, ele absorve todo o dano causado por fontes externas que normalmente afetariam você. Além disso, ele concede imunidade a condições negativas (como paralisia, queimadura, atordoamento, confusão, caído, impedido, entre outras) e impede a redução de Mudança de Status por efeitos externos. O escudo é considerado sem tipo para fins de resistências, vulnerabilidades e imunidades. O escudo e o usuário não podem ser curados enquanto ele estiver ativo, e ele não absorve efeitos ou danos causados por fontes internas, como confusão, veneno ou queimadura pré-existentes. O escudo se quebra quando for reduzido a 0 pontos de vida, e qualquer dano excedente é dissipado. Moves baseados em som ignoram o escudo. Observações: Shed Tail falha, e não troca o usuário, se o usuário já tiver um Substitute, se não houver companheiros de equipe para trocar, ou se os PV do usuário forem menores ou iguais a 50% de seus PV máximos. O escudo não bloqueia: Dano de recuo, condições ou efeitos causados por itens, habilidades ou efeitos passivos, e dano ou efeitos autoinfligidos, como os causados por confusão, envenenamento ou queimadura já existentes. O escudo pode ser transferido com Baton Pass, mantendo os PV restantes do escudo."
range_text_raw = "Pessoal"
duration_text_raw = "Instantânea"
effect_tags = Array[String](["recoil"])
