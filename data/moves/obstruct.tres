[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_if4sx"]

[resource]
script = ExtResource("1_if4sx")
id = "obstruct"
display_name = "Obstruct"
name_en = "Obstruct"
type = 15
pp = 5
move_time = "reação"
activation = 1
range_category = 0
range_distance = 0.0
duration_rounds = 1
description = "Você cruza os braços para bloquear o ataque do oponente. Quando você é alvo direto de um Move danoso de alvo único, você pode usar sua reação para evitar automaticamente o dano e efeitos desse e de qualquer outro Move danoso de alvo único direcionado a você até o início de seu próximo turno. Caso faça isso, você abre mão de sua ação padrão em seu próximo turno. Se algum ataque corpo a corpo for direcionado a você durante a ação do Obstruct, o atacante tem a Defesa reduzida em 2 estágios, podendo ser acumulado em até -6 estágios. Se na rodada anterior você tiver usado Obstruct ou algum dos Moves Protect, Detect, Endure, Spiky Shield, King's Shield, Baneful Bunker, Burning Bulwark, Max Guard e Silk Trap, role 1d6 para cada uso consecutivo bem -sucedido desses Moves, até o máximo de 6d6. Este Move só é bem-sucedido se todos os dados rolados resultarem em 5 ou 6."
range_text_raw = "Pessoal"
duration_text_raw = "Até o início do próximo turno"
effect_tags = Array[String](["stat_change", "protect"])
