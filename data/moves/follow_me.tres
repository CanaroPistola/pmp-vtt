[resource]
script = ExtResource("1_st8pb")
id = "follow_me"
display_name = "Follow Me"
name_en = "Follow Me"
move_time = "1 reação"
resolution = 2
has_save = true
save_attribute = 5
activation = 1
range_category = 2
range_distance = 15.0
duration_rounds = 1
description = "Você age rapidamente para atrair um inimigo para atacá - lo. Quando um inimigo em alcance ativa um Move que mira diretamente outra criatura, ou é capaz de atingi-la em uma área de efeito, você pode usar sua reação para forçar este inimigo a fazer um teste de CAR contra sua CD de Move. Em um a falha, o Move deve mirar em você em vez disso. Se for um Move de área de efeito, ele deve ter você como centro. Ao ativar este Move, você pode executá-lo novamente quantas vezes quiser contra outros inimigos até o início de seu próximo turno, sem gastar PP. Se você estiver fora do alcance do Move inimigo, a criatura deve usar seu deslocamento restante para se aproximar de você (sem provocar ataques de oportunidade). Caso ainda esteja fora de alcance, o Move dela falha automaticamente . Ativar este Move faz com que você perca sua ação em seu próximo turno. Observações: Follow Me não redireciona Future Sight , Doom Desire e nem Sky Drop . Follow Me atrai golpes do tipo Elétrico e Água mesmo que haja um Pokémon com Lightning Rod ou Storm Drain em campo. Se outro Pokémon da mesma equipe já estiver como centro das atenções, o primeiro a usar a técnica terá prioridade; se esse primeiro usuário estiver fora do alcance ou deixar de ser o centro das atenções, o ataque será redirecionado para o próximo centro das atenções. Follow Me não pode ser escolhido pelo Move Assist."
range_text_raw = "(15 metros)"
duration_text_raw = "Até o início do próximo turno"
move_power_attributes = Array[int]([4, 5])
