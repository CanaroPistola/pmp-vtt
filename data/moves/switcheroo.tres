status_roll_target_attribute = 1
description = "Suas mãos se movem com velocidade incrível enquanto você tenta trocar itens segurados com uma criatura. Role 1d20 + MOVE + 9 e compare o resultado com 10 + DES do alvo. Em um resultado maior ou igual, você pega o item segurado pelo alvo e o substitui pel o seu próprio. Caso não esteja segurando um item, você apenas pega o item do alvo. Caso o alvo não esteja segurando um item, você pode entregar a ele um item que esteja segurando. Observações: A Griseous Orb não pode ser removida de Giratina; as Type Plates não podem ser removidas de Arceus; os Drives não podem ser removid os de Genesect; e as Mega Pedras não podem ser removidas de seus respectivos Pokémon. Switcheroo não pode ser escolhido pelo Move Assist."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([1])
