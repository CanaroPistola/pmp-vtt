has_save = true
range_category = 2
range_distance = 30.0
description = "Você convoca uma chuva de flechas verdes para perfurar criaturas dentro do alcance. Todas as criaturas em um raio de 9 metros, centrado em um ponto dentro do alcance, devem fazer um teste de resistência de DES contra sua CD de Move, sofrendo 3d6 + MOVE de dano de terra em caso de falha, ou a metade disso em caso de sucesso. Criaturas do tipo Voador ou aquelas com Levitate, Magnet Rise ou habilidade similar PODEM ser atingidas por este Move. Qualquer criatura que falhe na jogada de resistência agora está Ao Chão e caída. Criaturas no chão são suscetíveis a Moves do tipo terra até se levantarem, independentemente de seu tipo ou habilidade."
scaling_text = "Os dados de dano para este Move mudam para 3d10 no nível 5, 3d12 no nível 10 e 4d12 no nível 17."
range_text_raw = "(30 metros)"
duration_text_raw = "Instantânea"
