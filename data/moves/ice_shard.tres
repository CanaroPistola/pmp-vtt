script = ExtResource("1_3ptb5")
id = "ice_shard"
display_name = "Ice Shard (Caco de Gelo)"
name_en = "Ice Shard"
name_pt = "Caco de Gelo"
type = 5
pp = 15
move_time = "1 ação / reação"
is_attack = true
resolution = 1
activation = 3
range_category = 2
range_distance = 15.0
description = "Você rapidamente cria pedaços de gelo pontiagudos e os arremessa contra um alvo. Como uma ação, faça um ataque à distância contra uma criatura ao alcance, causando 2d4 + MOVE de dano do tipo Gelo em um acerto. Este Move também pode ser usado como reação para ser executado a qualquer momento da rodada, desde que ocorra fora do turno de outra criatura e antes do início do seu turno. Se usar esta reação, você perde a ação padrão do seu próximo turno. Este Move é classificado como Prioridade 1. Caso outra criatura utilize um Move de Prioridade 1 no mesmo momento, a ordem de execução é determinada pela Destreza (ou por uma rolagem, em caso de empate). Moves com valores mais altos de Prioridade são sempre executados antes."
scaling_text = "Os dados de dano para este Move mudam para 1d12 no nível 5, 4d4 no nível 10 e 2d10 no nível 17."
range_text_raw = "(15 metros)"
duration_text_raw = "Instantânea"
