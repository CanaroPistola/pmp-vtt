[resource]
script = ExtResource("1_s3dlg")
id = "grassy_glide"
display_name = "Grassy Glide"
name_en = "Grassy Glide"
type = 4
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você desliza rente ao solo, atacando o alvo em extrema velocidade. Caso esteja dentro de um Grassy Terrain e em contato com o solo, este Move pode ser ativado como reação para ser executado a qualquer momento da rodada, desde que ocorra fora do turno de outra criatura (após um turno ser encerrado e antes da próxima criatura agir) e antes do início do seu próximo turno . Ao ativá-lo dessa forma, você pode se mover até 15 pés ( 4,5 metros ) imediatamente antes de realizar o ataque , sem de scontar de seu deslocamento total. Se usar esta reação, você perde a ação padrão do seu próximo turno. Neste caso, este Move é classificado como Prioridade 1. Caso outra criatura utilize um Move de Prioridade 1 no mesmo momento, a ordem de execução é determinada pela Destreza (ou por uma rolagem, em caso de empate). Moves com valores mais altos de Prioridade são sempre executados antes."
scaling_text = "Os dados de dano para este Move mudam para 4d4 no nível 5, 2d12 no nível 10 e 3d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
role = 0
move_power_attributes = Array[int]([0, 1])
has_damage = true
