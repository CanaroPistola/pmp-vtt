[resource]
script = ExtResource("1_7pbmf")
id = "chilly_reception"
display_name = "Chilly Reception"
name_en = "Chilly Reception"
type = 5
pp = 5
move_time = "1 ação"
range_category = 5
range_distance = 15.0
duration_rounds = 5
description = "Você conta uma piada terrivelmente sem graça e, em seguida, troca de lugar com um aliado enquanto uma nevasca é invocada. Você invoca o Move Snowscape, e logo em seguida é trocado por outro Pokémon do grupo. O usuário ainda será trocado mesmo que já esteja em uma tempestade de granizo quando o Move for usado. Se não houver outros aliados para trocar, o Move apenas ativará o clima. Descrição de Snowscape: Você provoca uma tempestade de neve em um raio de 50 pés (15 metros), sempre centrado em você e acompanhando seus movimentos. O efeito dura 5 rodadas, a menos que seja cancelado por Air Lock ou Cloud Nine, ou caso outro clima seja ativado em seguida e a área dele esteja encostada na sua. Usar Snowscape enquanto já houver uma tempestade de neve ativa não reinicia a duração. Durante a tempestade de neve, todos os Pokémon do tipo Gelo reduzem todo o dano recebido de ataques corpo a corpo em um valor igual ao seu bônus de proficiência."
range_text_raw = "Pessoal (raio de 15 metros)"
duration_text_raw = "Instantânea, 5 rodadas"
effect_tags = Array[String](["weather"])
