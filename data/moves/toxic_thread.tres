description = "Você dispara uma trama de fios venenosos contra uma criatura dentro do alcance. Role 1d20 + MOVE  + 9 e compare o resultado com 10 + CON do alvo. Em um resultado maior ou igual, o alvo fica Envenenado e tem sua Velocidade reduzida em 1 estágio, podendo ser acumulado em até -6 estágios. Uma criatura cuja Velocidade seja reduzida a 0 com este Move fica impedida. O alvo pode gastar uma ação para se livrar de qualquer teia com um teste de FOR contra uma CD igual a 10 + bônus de proficiência do usuário deste Move + 1 pra cada acúmulo de teia."
range_text_raw = "(18 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([1])
effect_tags = Array[String](["stat_change", "poison"])
