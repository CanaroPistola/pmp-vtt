id = "rollout"
display_name = "Rollout (Rolo Compressor)"
name_en = "Rollout"
name_pt = "Rolo Compressor"
type = 12
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você se lança em direção a um alvo, desferindo ataques sucessivos com força crescente. Avance obrigatoriariamente 20 pés (6 metros) em linha reta e realize um ataque corpo a corpo -1 contra cada criatura no trajeto, causando 1d6 + MOVE de dano do tipo Pedra em cada acerto. Se atingir um alvo que seja duas ou mais escalas de tamanho maior que a sua, você ricocheteia ao colidir, continuando o movimento na direção oposta do golpe. Se você usar este Move em rodadas consecutivas, dobre a quantidade de dados de dano a cada acerto subsequente. O multiplicador máximo é de 16× o dano base. O acúmulo de dano é perdido se qualquer ataque errar ou se você ficar incapacitado."
scaling_text = "O dado de dano para este Move muda para 1d10 no nível 5, 1d12 no nível 10 e 2d8 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
role = 0
