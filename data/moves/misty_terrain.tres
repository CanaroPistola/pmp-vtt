[resource]
script = ExtResource("1_463mv")
id = "misty_terrain"
display_name = "Misty Terrain (Campo Enevoado)"
name_en = "Misty Terrain"
name_pt = "Campo Enevoado"
type = 17
pp = 5
move_time = "1 ação"
range_category = 5
range_distance = 12.0
duration_rounds = 5
description = "Você cobre o chão com uma névoa fina e curativa em um círculo ao seu redor. Durante 5 rodadas, nenhuma criatura no chão dentro da névoa pode sofrer novas Condições de Status. Criaturas no chão são aquelas que não estão utilizando sua velocidade de vôo ou sobre efeito de Levitate, Magnet Rise ou Telekinesis. Além disso, os Moves do tipo Dragão têm seus dados de dano reduzidos pela metade, sejam estes ativados dentro da área ou contra alvos dentro da área (caso seja uma rolagem com apenas 1 dado, role o dano duas vezes e escolha o menor resultado). Misty Terrain é uma condição de terreno e pode coexistir ao mesmo tempo que condições climáticas, mas não com outras condições de terreno. Se uma nova condição de terreno for ativada na mesma área, ela substitui a anterior."
range_text_raw = "Pessoal (raio de 12 metros)"
duration_text_raw = "5 rodadas"
