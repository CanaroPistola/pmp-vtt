move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você usa o próprio poder de uma criatura contra ela mesma. Faça um ataque corpo a corpo contra uma criatura alvo. Em caso de acerto, o alvo sofre uma quantidade de dano sombrio igual a 1d20 + MOVE do alvo, e utilizando todos os bônus de Ataque que a criatura tiver. Em outras palavras, o Move age como se o alvo estivesse atacando a si mesmo."
scaling_text = "Os dados de dano para este Move mudam para 3d10 no nível 5, 4d10 no nível 10 e 6d8 no nível 17."
