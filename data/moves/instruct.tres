description = "Você instrui uma criatura a agir novamente. Como uma ação, escolha um alvo dentro do alcance. O alvo deve repetir imediatamente o Move que usou em sua última ação ou ação bônus. Em outras palavras, permite que um companheiro de equipe ataque duas vezes na rodada em vez de os dois Pokémon atacarem uma vez cada. Caso seja algo contra a vontade do alvo, ele deve fazer um teste de CAR contra sua CD de Move. Caso seja um Move que não possa ser ativado novamente, o efeito falha, e nenhum PP do alvo é gasto."
range_text_raw = "(6 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([4, 5])
