id = "order_up"
display_name = "Order Up"
name_en = "Order Up"
type = 14
pp = 5
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você ataca o alvo com uma postura elegante. Faça um ataque corpo a corpo, causando 4d4 + MOVE de dano do tipo Dragão em um acerto. Este Move não aciona efeitos de inimigos que se ativam ao contato corpo a corpo. Se você tiver um Tatsugiri na boca por meio da habilidade Commander, você receberá um bônus ao acertar o Move, com base na forma do Tatsugiri: Forma Curva aumenta o Ataque em 1 estágio, Forma Caída aumenta a Defesa em 1 estágio e Forma Esticada aumenta a Velocidade em 1 estágio. Observações: Order Up é fortalecido por Sheer Force mesmo que Commander não esteja ativado, e as Mudanças de Status, se houver, são aplicadas normalmente."
scaling_text = "Os dados de dano para este Move mudam para 4d6 no nível 5, 4d8 no nível 10 e 4d10 no nível 17."
range_text_raw = "Corpo a Corpo"
duration_text_raw = "Instantânea"
