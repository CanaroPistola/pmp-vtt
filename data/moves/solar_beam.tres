duration_flags = Array[String](["concentration"])
description = "Ao usar este Move, você absorve energia solar e se prepara para liberar um raio devastador. No seu próximo turno, se você mantiver a concentração, use uma ação para criar uma linha de energia solar de 24 metros, com  (1,5 metros) de largura. Qualquer criatura pega na linha deve ter sucesso em um teste de DES ou sofrer 3d8 + MOVE de dano de grama em caso de falha e metade disso em caso de sucesso. Se este Move for usado sob luz solar intensa, ele pode ser executado imediatamente no momento em que for ativado, sem necessidade de concentração."
scaling_text = "Os dados de dano para este Move mudam para 6d6 no nível 5, 6d8 no nível 10 e 6d10 no nível 17."
range_text_raw = "Pessoal (linha de 24 metros)"
duration_text_raw = "1 rodada, Concentração"
