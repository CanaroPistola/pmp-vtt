[resource]
script = ExtResource("1_oghqj")
id = "assist"
display_name = "Assist (Assistência)"
name_en = "Assist"
name_pt = "Assistência"
move_time = "1 ação"
range_category = 6
range_distance = 0.0
duration_flags = Array[String](["variable"])
description = "Você convoca um orbe branco à sua frente, que lhe permite replicar um Move de outra criatura em seu grupo. Ao ativar este Move, role um dado mais próximo da quantidade de Pokémon que você tem no grupo, sorteando um deles. Com o Pokémon escolhido, role 1d4 para escolher um de seus Moves para ser utilizado (exceto Struggle), ou 1d6, caso tenha Move Extra (caso caia 6, role novamente). Você pode escolher usar sua movimentação após saber qual Move irá utilizar, e antes dele ser executado. Assist pode replicar um Move mesmo se for de um Pokémon desmaiado ou que não tenha mais PP. Alguns Moves não podem ser utilizados com Assist, e isso está descrito ao final de cada um deles."
range_text_raw = "Variável"
duration_text_raw = "Variável"
