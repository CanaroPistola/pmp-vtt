[resource]
script = ExtResource("1_6pvsy")
id = "baneful_bunker"
display_name = "Baneful Bunker"
name_en = "Baneful Bunker"
type = 7
pp = 5
move_time = "1 reação"
activation = 1
range_category = 0
range_distance = 0.0
duration_rounds = 1
description = "Você sente o perigo iminente e consegue criar rapidamente uma barreira para evitá-lo. Quando você é alvo direto do dano e/ou efeitos de um Move de alvo único, você pode usar sua reação para evitar automaticamente o dano e efeitos desse e de qualquer outro Move de alvo único direcionado a você até o início de seu próximo turno . Caso faça isso, você abre mão de sua ação padrão em seu próximo turno. Se algum ataque corpo a corpo for direcionado a você durante o efeito do Baneful Bunker, o atacante fica envenenado. Se na rodada anterior você tiver usado Baneful Bunker ou algum dos Moves Protect, Detect, Endure, Wide Guard, Quick Guard, Spiky Shield , King's Shield, Burning Bulwark, Max Guard, Obstruct ou Silk Trap , role 1d6 para cada uso consecutivo bem -sucedido desses Moves, até o máximo de 6d6. Este Move só é bem-sucedido se todos os dados rolados resultarem em 5 ou 6. Observações: Baneful Bunker não pode ser escolhido pelo Move Assist."
range_text_raw = "Pessoal"
duration_text_raw = "Até o início do próximo turno"
effect_tags = Array[String](["protect", "poison"])
