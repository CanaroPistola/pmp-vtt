id = "rock_smash"
display_name = "Rock Smash (Esmagamento de Rochas)"
name_en = "Rock Smash"
name_pt = "Esmagamento de Rochas"
type = 6
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você ataca com um golpe esmagador de rocha que pode diminuir a defesa de um usuário. Faça um ataque contra uma criatura, causando 2d4 + MOVE de dano lutador em um acerto. Em um resultado natural de 11 ou mais no acerto, a Defesa do alvo é reduzida em 1 estágio, podendo ser acumulada em até -6 estágios. Ao atingir uma rocha ou estrutura rochosa, este Move causa o dobro do dano, podendo ser usado para abrir passagens ou destruir obstáculos de pedra, a critério do Mestre."
scaling_text = "Os dados de dano para este Move mudam para 1d12 no nível 5, 4d4 no nível 10 e 2d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
