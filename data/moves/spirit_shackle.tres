move_time = "1 ação"
is_attack = true
resolution = 1
range_category = 2
range_distance = 15.0
description = "Você emprega energia sombria para prender a sombra de uma criatura ao chão. Faça um ataque à distância, causando 4d4 + MOVE de dano fantasma em caso de acerto. Se atingir, a sombra do alvo fica presa ao ponto exato em que ele estava no momento do acerto, criando uma área de 50 pés ao redor, centrada nesse local. Enquanto estiver afetado, o alvo fica impossibilitado de fugir , ser trocado ou se afastar para além do alcance dessa área. O efeito se mantém enquanto você permanecer dentro dessa área . Isso não impede os efeitos de Moves, habilidades passivas ou itens que forçam a substituição do alvo, como Dragon Tail, Whirlwind ou Eject Button."
scaling_text = "Os dados de dano para este Move mudam para 4d6 no nível 5, 4d8 no nível 10 e 4d10 no nível 17."
range_text_raw = "(15 metros)"
duration_text_raw = "Instantânea"
role = 0
