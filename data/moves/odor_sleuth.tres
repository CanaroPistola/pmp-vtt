description = "Você exala uma onda de energia em direção a uma criatura dentro do alcance, envolvendo -a com um odor característico. Role 1d20 + MOVE + 9 e compare o resultado com 10 + SAB do alvo. Em um resultado maior ou igual, o alvo não pode se beneficiar de aumentos em sua Evasão. Além disso, se o alvo for do tipo Fantasma, ele passa a poder ser acertado por Moves dos tipos Normal e Lutador durante a duração. Observações: Este Move ignora Substitute."
range_text_raw = "(9 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([3, 4])
