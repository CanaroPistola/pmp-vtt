range_category = 5
range_distance = 12.0
description = "Você libera uma onda de choque poderosa que rasga as criaturas e o espaço ao redor delas. Todas as criaturas dentro de 12 metros de você devem fazer um teste de CON contra sua CD do Move -1, sofrendo 2d10 + MOVE de dano de dragão em caso de falha, ou metade disso em caso de sucesso. Criaturas que falharem neste teste por 5 ou mais receberão mais 1 dado de dano extra e, além disso, se tornarão incontroláveis e serão sugadas para o Plano Etéreo até o início do seu próximo turno, aparecendo no mesmo local quando retornarem."
scaling_text = "Os dados de dano para este Move mudam para 5d6 no nível 5, 5d8 no nível 10 e 5d10 no nível 17."
range_text_raw = "Pessoal (raio de 12 metros)"
duration_text_raw = "Instantânea"
role = 0
