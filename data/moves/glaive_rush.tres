id = "glaive_rush"
display_name = "Glaive Rush"
name_en = "Glaive Rush"
type = 14
pp = 3
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você se lança em um ataque imprudente com todo o corpo, ficando vulnerável por um breve período. Você pode se mover no ar até uma distância igual ao seu deslocamento restante para alcançar o alvo, e realizar um ataque corpo a corpo, causando 3d8 + MOVE de dano do tipo dragão em um acerto. Caso o Move acerte, todos os golpes direcionados a você até o início de seu próximo turno causam o dobro do dano e possuem acerto garantido (devendo rolar um d20 para chance de golpe crítico e outros efeitos). Cair de uma altura igual ou inferior ao deslocamento que você gastou no ar não causa dano de queda."
scaling_text = "Os dados de dano para este Move mudam para 6d6 no nível 5, 6d8 no nível 10 e 6d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
