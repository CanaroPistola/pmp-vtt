id = "collision_course"
display_name = "Collision Course"
name_en = "Collision Course"
type = 6
pp = 3
move_time = "1 ação"
is_attack = true
resolution = 1
description = "Você se transforma e despenca contra o chão, provocando uma enorme explosão pré-histórica. Avance obrigatoriamente 20 pés (6 metros) em linha reta sem sofrer ataques de oportunidade, e realize um ataque corpo a corpo contra cada criatura no trajeto, causando 2d10 + MOVE de dano do tipo lutador em um acerto. Se atingir um alvo que seja duas ou mais escalas de tamanho maior que a sua, você ricocheteia ao colidir, continuando o movimento na direção oposta do golpe. Caso este Move seja super efetivo contra um alvo, role os dados de dano duas vezes e escolha o maior resultado apenas para ele. Durante este Move, cada criatura só pode sofrer dano uma única vez, mesmo que seja atingida novamente no trajeto."
scaling_text = "Os dados de dano para este Move mudam para 5d6 no nível 5, 5d8 no nível 10 e 5d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
