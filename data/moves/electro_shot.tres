duration_flags = Array[String](["concentration"])
description = "Você concentra energia elétrica em seu corpo e, em seguida, dispara um tiro de altíssima voltagem. Ao ativar este Move, seu Ataque Especial aumenta em 1 estágio, podendo ser acumulado em até 6 estágios. Com uma ação completa no seu próximo turno, se você mantiver sua concentração, você realiza um ataque à distância contra um alvo em alcance, causando 4d6 + MOVE de dano do tipo elétrico em um acerto. A criatura atingida deve ser bem-sucedida em um teste de resistência de FOR contra sua CD do Move ou ser derrubada. Após selecionar Electro Shot, o usuário não pode ser trocado para fora da batalha até que o Move seja interrompido ou totalmente executado. Caso seja usado durante a chuva, Electro Shot é executado em 1 único turno, aumentando o Ataque Especial e realizando o ataque no mesmo turno. As condições dormindo, congelado e atordoado pausam, mas não interrompem, a duração de Electro Shot."
scaling_text = "Os dados de dano para este Move mudam para 2d20 no nível 5, 5d10 no nível 10 e 8d8 no nível 17."
range_text_raw = "(30 metros)"
duration_text_raw = "1 rodada, Concentração"
