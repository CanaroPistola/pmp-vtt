description = "Você libera um cone de esporos de algodão espesso, cobrindo todos à sua frente. Para cada criatura dentro do cone, role 1d20 + MOVE + 9 e compare o resultado com 10 + CON do alvo. Em um resultado maior ou igual, o alvo tem sua Velocidade reduzida em 2 estágios, podendo ser acumulado em até -6 estágios . Uma criatura cuja Velocidad e seja reduzida a 0 com este Move fica impedida. O alvo pode gastar uma ação para tentar se livrar de qualquer algodão com um teste de FOR contra uma CD igual a 10 + bônus de proficiência do usuário deste Move + 1 pra cada acúmulo de estágios negativos causados por esse Move."
range_text_raw = "Pessoal (cone de 6 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([1, 2])
effect_tags = Array[String](["stat_change"])
