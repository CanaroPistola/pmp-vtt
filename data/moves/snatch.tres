[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_glklp"]

[resource]
script = ExtResource("1_glklp")
id = "snatch"
display_name = "Snatch"
name_en = "Snatch"
type = 15
pp = 5
move_time = "1 reação"
resolution = 4
has_status_roll = true
status_roll_bonus = 9
activation = 1
range_category = 2
range_distance = 9.0
description = "Você convoca energia sombria para roubar o efeito de uma criatura. Quando uma criatura dentro do alcance usar um Move de Status em si mesma, você pode gastar sua reação para tentar tomar esse efeito para você. Role 1d20 + MOVE + 9 e compare o resultado com 10 + SAB do alvo. Em um resultado maior ou igual, o efeito positivo do Move é aplicado em você, e o Move falha para o alvo original. Caso o efeito seja aplicado, você abre mão de sua ação padrão no próximo turno. Moves que podem ser roubados com Snatch: • Moves de Status, como Swords Dance ou Belly Drum (com exceções abaixo); • Moves de proteção, como Substitute, Lucky Chant, Wide Guard ou Quick Guard (com exceções abaixo); • Moves de recuperação e cura, como Recover, Ingrain ou Heal Bell; • Imprison; • Outros efeitos autoinduzidos, como Magn et Rise, Power Trick ou Light Screen. Moves que não podem ser roubados com Snatch: • Acupressure; • Psych Up; • Curse; • Moves de autoproteção como Protect ou Detect; • Helping Hand; • Taunt. Observações: Snatch não pode ser escolhido pelo Move Assist."
range_text_raw = "(9 metros)"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([1])
