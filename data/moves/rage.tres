id = "rage"
display_name = "Rage (Fúria)"
name_en = "Rage"
name_pt = "Fúria"
move_time = "1 ação"
is_attack = true
resolution = 1
duration_is_permanent = true
description = "Você entra em um ataque de raiva, e se enfurece cada vez mais. Faça um ataque corpo a corpo contra uma criatura, causando 1d4 + MOVE de dano normal em um acerto. Até o início do seu próximo turno, sempre que sofrer dano direto de um ataque de alvo único (incluindo cada golpe individual de Moves com múltiplos acertos), seu Ataque será aumentado em 1 estágio, podendo ser acumulado em até 6 estágios. Os aumentos de Ataque ocorrem sempre que Rage for o último Move utilizado, mesmo que ele erre nas próximas vezes, que o usuário fique incapacitado (paralisado, adormecido, etc.) ou que o treinador use um item."
scaling_text = "O dado de dano para este Move muda para 1d6 no nível 5, 1d8 no nível 10 e 1d10 no nível 17."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Enquanto ativo"
