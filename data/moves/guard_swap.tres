move_time = "1 ação"
resolution = 4
has_status_roll = true
status_roll_bonus = 9
range_category = 2
range_distance = 9.0
duration_is_permanent = true
description = "Você usa seu poder psíquico para trocar sua defesa com a de uma criatura dentro do alcance. Role 1d20 + MOVE + 9 e compare o resultado com 10 + SAB do alvo. Em um resultado maior ou igual, você troca sua CA com a do alvo pela duração. Alterações temporárias nos atributos, seja por Habilidades ou itens, são ignoradas durante a troca. Observações: Este Move ignora Substitute."
range_text_raw = "(9 metros)"
duration_text_raw = "Enquanto ativo"
move_power_attributes = Array[int]([3, 4])
