[resource]
script = ExtResource("1_737h0")
id = "comeuppance"
display_name = "Comeuppance"
name_en = "Comeuppance"
type = 15
pp = 5
move_time = "1 reação"
is_attack = true
resolution = 1
activation = 1
description = "Você contra-ataca com força muito maior o oponente que foi o último a causar dano a você. Após você ser atingido por um Move danoso, você pode usar sua reação para desferir um ataque corpo a corpo contra a criatura, causando 1,5x do dano recebido como dano do tipo sombrio em caso de acerto (máximo de 5 vezes o seu nível atual). Caso faça isso, você abre mão de sua ação padrão em seu próximo turno. Caso a criatura não esteja em seu alcance corpo a corpo, mas esteja em seu alcance de deslocamento, você pode se mover até ela durante esta reação, mas fazer isso também abre mão de sua ação de movimento do próximo turno. Observação: Comeuppance só reflete o último golpe de Moves com múltiplos golpes e não reflete ataques absorvidos por Substitute."
range_text_raw = "Corpo a corpo"
duration_text_raw = "Instantânea"
move_power_attributes = Array[int]([0, 1])
