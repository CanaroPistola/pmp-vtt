[ext_resource type="Script" uid="uid://dnutt1ictghku" path="res://scripts/data/move_data.gd" id="1_derpf"]

[resource]
script = ExtResource("1_derpf")
id = "recycle"
display_name = "Recycle"
name_en = "Recycle"
pp = 5
move_time = "1 ação"
range_category = 0
range_distance = 0.0
description = "Você reconstrói um item consumido recentemente e o traz de volta à sua posse. Se não estiver carregando nenhum item, este Move pode ser usado para recuperar o último item consumido por você durante este combate, permitindo que ele seja utilizado normalmente. Caso seja consumido outra vez, poderá ser recuperado com um novo uso de Recycle . Fora de combate, este Move só pode ser usado uma vez por item, desde que ele tenha sido consumido nos últimos 10 minutos."
range_text_raw = "Pessoal"
duration_text_raw = "Instantânea"
