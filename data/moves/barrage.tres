range_category = 2
range_distance = 9.0
description = "Você dispara uma rápida sequência de pequenos projéteis contra o alvo. Faça um ataque à distância -2 em uma criatura, causando 1d4 + MOVE de dano normal em um acerto. Em um acerto, após isso, role um d8 e compare o resultado com a tabela abaixo para determinar a quantidade de golpes. Para cada golpe adicional, você pode imediatamente realizar um novo ataque contra o mesmo alvo com acerto garantido, causando 1d4 + MOVE de dano normal. Cada golpe extra deve rolar separadamente 1d20 para verificar chance de crítico. Confira a tabela no livro."
scaling_text = "O dado de dano para esse Move muda para 1d6 no nível 10 e 1d8 no nível 17."
range_text_raw = "(9 metros)"
duration_text_raw = "Instantânea"
