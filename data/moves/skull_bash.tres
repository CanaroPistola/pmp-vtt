duration_rounds = 1
duration_flags = Array[String](["concentration"])
description = "Você se abaixa e investe contra o inimigo, usando a cabeça como uma massa de impacto. Ao ativar este Move, sua Defesa aumenta em 1 estágio, podendo ser acumulado em até 6 estágios. Com uma ação completa no seu próximo turno, se você mantiver sua concentração, você avança em linha reta em direção a uma criatura, a uma distância de até o dobro de seu deslocamento, ignorando quaisquer ataques de oportunidade, para um ataque corpo a corpo, causando 4d6 + MOVE de dano normal em um acerto. A criatura atingida deve ser bem-sucedida em um teste de resistência de FOR contra sua CD do Move ou ser derrubada."
scaling_text = "Os dados de dano para este Move mudam para 2d20 no nível 5, 5d10 no nível 10 e 8d8 no nível 17."
