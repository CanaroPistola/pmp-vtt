duration_flags = Array[String](["concentration"])
description = "Você reúne energia vinda do espaço e a libera em um ataque poderoso. Ao ativar este Move, seu Ataque Especial aumenta em 1 estágio, até o máximo de 6 estágios. No seu próximo turno, se você mantiver a concentração, use uma ação para criar uma linha de energia de 80 pés (24 metros), com 5 pés (1,5 metros) de largura. Qualquer criatura pega na linha deve ter sucesso em um teste de DES contra sua CD de Move -1, ou sofrer 3d8 + MOVE de dano de pedra em caso de falha e metade disso em caso de sucesso. Dormir, congelar, ser imobilizado e ficar atordoado pausam, mas não interrompem, a duração de Meteor Beam."
scaling_text = "Os dados de dano para este Move mudam para 6d6 no nível 5, 6d8 no nível 10 e 6d10 no nível 17."
range_text_raw = "Pessoal (linha de 24 metros)"
duration_text_raw = "1 rodada, Concentração"
